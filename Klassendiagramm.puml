@startuml

class User {
  - userId : String
  - name : String
  - geburtsdatum : LocalDate
  - email : String
  - adresse : Adresse
  - passwort : String
  + profilErstellen(email : String, passwort : String) : boolean
  + profilBearbeiten() : boolean
  + profilLoeschen() : boolean
  + userMelden(userId : String, grund : String) : Report
}

class Helfer {
  - aktuelleTeilnahmen : List<Hilfsangebot>
  - erreichbarkeitsZeitraum : Kalender
  - skills : List<Skills>
  + aufGesuchBewerben(gesuchID : String) : boolean
  + zeitraumAnpassen() : boolean
  + teilnahmeZurückziehen() : boolean
  + gesuchAnnehmen(gesuchID : String) : boolean
  + gesuchAblehnen(gesuchID : String) : boolean
  + aufGesuchBewerben(gesuchID : String) : boolean

}

class Suchender {
  - organisation : String
  - gesuche : List<Hilfsgesuch>
  + gesuchErstellen(beschreibung : String, anzahlGesuchteHelfer : int) : Hilfsgesuch
  + benachrichtigungVerschicken(nachricht : String) : boolean
  + helferAnnehmen() : boolean
  + helferAblehnen() : boolean
}

class Admin {
  - gemeldeteInhalte : List<Report>
  - rechte : List<Rechte>
  + nutzerSperren(userID : String) : boolean
  + nutzerEntsperren(userID : String) : boolean
}

class Report {
  - reportId : String
  - grund : String
  - details : String
  - erstelltAm : DateTime
}

User "1" <-- "0..*" Report : melder
User "1" <-- "0..*" Report : gemeldet

enum Rechte {
  USERVERWALTUNG
  ROLLENVERWALTUNG
  INHALTSMODERATION
}

User <|-- Helfer
User <|-- Suchender
User <|-- Admin

class Adresse {
  - land : String
  - stadt : String
  - plz : String
  - strasse : String
  - hausnummer : String
  - longitude : double
  - latitude : double
}

enum Status {
  ENTWURF
  OFFEN
  RESERVIERT
  IN_BEARBEITUNG
  ERFUELLT
  ABGEBROCHEN
}

abstract class HilfeEintrag {
  - id : String
  - zeitraeume : List<Zeitraum>
  - adresse : Adresse
  - skills : List<Skills>
  + addZeitraum(zeitraum : Zeitraum) : boolean
  + removeZeitraum(zeitraum : Zeitraum) : boolean
}

class Hilfsgesuch {
  - beschreibung : String
  - anzahlGesuchteHelfer : int
  - helferListe : List<Helfer>
  - status : Status
  + addHelfer(helfer : Helfer) : boolean
  + getStatus() : Status
  + isFilled() : boolean
  + veroeffentlichen() : boolean
  + alsEntwurfSpeichern() : boolean
}

Suchender "1" o-- "0..*" Hilfsgesuch
HilfeEintrag <|-- Hilfsgesuch

class Hilfsangebot {
  - helfer : Helfer
  - angebotsspezifischeSkills : List<Skills> 
  + getKombinierteSkills() : List<Skills>
}

Helfer "1" -- "0..*" Hilfsangebot
HilfeEintrag <|-- Hilfsangebot

enum Wiederholung {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

class Zeitraum {
  - startZeit : LocalDateTime
  - endZeit : LocalDateTime
  - wiederholung : Wiederholung
  + ueberschneidetSich(mit : Zeitraum) : boolean
}

Zeitraum "*" --o "1" HilfeEintrag
Zeitraum "*" --o "1" Kalender

enum Skills {
  TRAGEN_HEBEN
  AUFRAEUMARBEITEN
  TECHNISCHE_HILFE
  STROMVERSORGUNG
  PUMPEN_BEDIENEN
  MATERIALVERTEILUNG
  TRANSPORT
  ERSTE_HILFE
  SANITAETSDIENST
  BETREUUNG_VON_PERSONEN
  UNTERKUNFTSBETRIEB
  FUNK_KOMMUNIKATION
  KOORDINATION_UNTERSTUETZUNG
}

class Benachrichtigung {
  - id : UUID
  - nachricht : String
  - gelesen : boolean
  + senden()
  + markierenAlsGelesen()
}

User "1" <-- "0..*" Benachrichtigung : empfaenger
User "1" <-- "0..*" Benachrichtigung : sender

class Kalender {
  - zeitraeume : List<Zeitraum>
  + addZeitraum(z : Zeitraum)
  + removeZeitraum(z : Zeitraum)
}

User "1" -- "1" Kalender

class Gui {
  - currentUser : User
  + start()
  + navigateTo(view : View)
}

class ZuordnungsService {
  - angebote : List<Hilfsangebot>
  - gesuche : List<Hilfsgesuch>
  + match(gesuch : Hilfsgesuch) : List<Hilfsangebot>
  + match(angebot : Hilfsangebot) : List<Hilfsgesuch>
  + weiseHelferZu(gesuch : Hilfsgesuch, angebot : Hilfsangebot) : boolean
  + faehigkeitenMatch(angebot : Hilfsangebot, gesuch : Hilfsgesuch) : boolean
  + ortRadiusMatch(angebot : Hilfsangebot, gesuch : Hilfsgesuch, radiusKm : double) : boolean
  + zeitMatch(angebot : Hilfsangebot, gesuch : Hilfsgesuch) : boolean
  + berechneDistanz(a1 : Adresse, a2 : Adresse) : double
  + aktualisierStatus(gesuch : Hilfsgesuch, status : Status) : boolean
}

class View

Gui -- ZuordnungsService
ZuordnungsService --> Hilfsgesuch
ZuordnungsService --> Hilfsangebot
Gui "1" --> "*" View

@enduml